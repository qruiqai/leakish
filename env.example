# Detect app environment variables.
# Copy to .env.local for local development.

# ---- Database ----
# Use a separate logical DB from manager. Locally, the simplest is a sibling DB
# on the same MySQL instance, e.g. mysql://root:pass@127.0.0.1:3306/detect
DATABASE_URL=mysql://root:password@127.0.0.1:3306/detect

# ---- NextAuth ----
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth ----
# Configure at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Privacy / hashing ----
# Used to hash client IPs before storing them. Rotate at most once a year.
IP_HASH_SALT=replace-with-openssl-rand-base64-32

# ---- Optional: ipinfo.io free token (for ASN / VPN / proxy detection) ----
# IPINFO_TOKEN=

# ---- Optional: Email login (Mailgun) ----
# Without these, magic-link sign-in still works locally — the link is printed
# to the dev server console. In production, missing these will refuse to send
# (we never silently no-op a login attempt).
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_REGION=us           # or 'eu'
# EMAIL_FROM=Leakish <noreply@example.com>

