apiVersion: v1
kind: Secret
metadata:
  name: leakish-secrets
  namespace: leakish-dev
  annotations: {}
type: Opaque
data:
  # All values must be base64-encoded.  cat <file> | base64
  DATABASE_URL: ''
  NEXTAUTH_SECRET: ''
  NEXTAUTH_URL: ''
  GOOGLE_CLIENT_ID: ''
  GOOGLE_CLIENT_SECRET: ''
  IP_HASH_SALT: ''
  # Optional: leave empty to disable VPN/Proxy detection
  IPINFO_TOKEN: ''
  # Optional: email magic-link login. Omit any of these and email login is disabled.
  MAILGUN_API_KEY: ''
  MAILGUN_DOMAIN: ''
  MAILGUN_REGION: ''
  EMAIL_FROM: ''
  # Stripe (subscriptions). Leave empty in environments where billing is off.
  # When set, requires the four price IDs to enable Starter/Pro purchase paths.
  # Prefer a Restricted API Key (`rk_…`) over a secret key (`sk_…`). Scopes:
  # Checkout Sessions / Customers / Customer Portal Sessions = Write;
  # Subscriptions / Prices / Products / Webhook Endpoints = Read.
  STRIPE_SECRET_KEY: ''
  STRIPE_WEBHOOK_SECRET: ''
  STRIPE_PRICE_STARTER_MONTHLY: ''
  STRIPE_PRICE_STARTER_YEARLY: ''
  STRIPE_PRICE_PRO_MONTHLY: ''
  STRIPE_PRICE_PRO_YEARLY: ''
  # Optional: public app URL used for Stripe success / cancel redirects.
  # Falls back to NEXTAUTH_URL when unset.
  NEXT_PUBLIC_APP_URL: ''
